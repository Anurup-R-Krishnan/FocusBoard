[Unit]
Description=FocusBoard ML Service
After=network.target

[Service]
Type=simple
ExecStart=/usr/share/focusboard/ml-service/venv/bin/uvicorn main:app --host 0.0.0.0 --port 5001
WorkingDirectory=/usr/share/focusboard/ml-service
Environment=PORT=5001
Environment=MODEL_NAME=all-MiniLM-L6-v2
Environment=MIN_SIMILARITY=0.3
Environment=INFERENCE_DEVICE=cpu
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
