[Unit]
Description=FocusBoard Backend API
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/node /usr/share/focusboard/backend/server.js
WorkingDirectory=/usr/share/focusboard/backend
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=ML_SERVICE_URL=http://localhost:5001
Environment=MONGODB_URL=nedb://./data
Environment=JWT_SECRET_FILE=%h/.config/focusboard/jwt-secret
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
