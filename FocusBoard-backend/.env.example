# Environment Variables

# Database
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/focusboard

# Authentication
JWT_SECRET=your_secret_key_change_in_production

# Server
PORT=5000

# ML Service
ML_SERVICE_URL=http://localhost:5001

# Worker configuration
# Backend cluster workers (default: 2; set to cpu count for max throughput)
WORKERS=2
# ML service async worker pool (coroutines inside the single uvicorn process)
ML_WORKERS=4
# ML request timeout in ms
ML_TIMEOUT_MS=5000

# ML response cache
# TTL for cached ML responses in ms (default: 10 minutes)
ML_CACHE_TTL_MS=600000
# Max number of cached ML responses
ML_CACHE_MAX_ENTRIES=500

# Email Configuration for NSFW Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=FocusBoard <noreply@focusboard.app>
PARENT_EMAIL=parent@example.com

# Rate limiting
RATE_LIMIT_MAX=1500
